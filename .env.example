# LINE Messaging API
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_ACCESS_TOKEN=your_channel_access_token_here

# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 商材LP URL（占い結果のCTAボタンリンク先）
CTA_URL=https://your-lp-url.com

# アクセス解析（Vercel KVをプロジェクトに接続すると自動で追加される）
KV_REST_API_URL=https://your-kv-instance.upstash.io
KV_REST_API_TOKEN=your_kv_rest_api_token_here

# /dashboard と /api/stats にアクセスするためのパスワード代わりのトークン（自分で好きな文字列を決める）
ANALYTICS_DASHBOARD_TOKEN=choose_a_long_random_string
